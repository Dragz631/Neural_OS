# Copie este arquivo para ".env.local" e preencha. O .env.local NÃO vai pro git.
# Depois de mudar, reinicie o "npm run dev".

# ── Hermes Agent (Nous Research) ──────────────────────────────────────────────
# O Hermes roda o modelo (ex.: via NVIDIA NIM) e expõe uma API compatível com OpenAI.
# Ative o API server no config do Hermes (porta padrão 8642).
HERMES_URL=http://localhost:8642
HERMES_API_KEY=

# ── NVIDIA NIM direto (sem Hermes) ────────────────────────────────────────────
# Chave grátis em https://build.nvidia.com (começa com nvapi-)
NVIDIA_API_KEY=

# ── Ollama local (opcional) ───────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# ── Obsidian ──────────────────────────────────────────────────────────────────
# Caminho do SEU cofre de estudos. O app cria a pasta "Neural-OS" dentro dele.
# Exemplo: OBSIDIAN_VAULT_PATH=D:\Usuários\Claude-X90\Estudos
OBSIDIAN_VAULT_PATH=

# Cofre de estudos (lousas .excalidraw e resumo pro Brazuka). Se vazio, usa o OBSIDIAN_VAULT_PATH.
ESTUDOS_VAULT_PATH=
